@model IEnumerable<PhoneStore.Models.Roles>
<h1>Roles</h1>
<p><a asp-action="Create" asp-area="Admin" class="btn btn-primary">Create</a></p>
<table class="table">
<thead><tr><th>Id</th><th>Name</th><th>Description</th><th></th></tr></thead>
<tbody>
@foreach(var r in Model){<tr><td>@r.Id</td><td>@r.Name</td><td>@r.Description</td><td>
<a asp-action="Edit" asp-route-id="@r.Id" asp-area="Admin" class="btn btn-sm btn-warning">Edit</a>
<a asp-action="Details" asp-route-id="@r.Id" asp-area="Admin" class="btn btn-sm btn-info">Details</a>
<form asp-action="Delete" asp-route-id="@r.Id" asp-area="Admin" method="post" style="display:inline">@Html.AntiForgeryToken()<button class="btn btn-sm btn-danger">Delete</button></form>
</td></tr>}
</tbody></table>
