@model IEnumerable<PhoneStore.Models.Orders>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

@functions {
    public string GetStatusText(int? status)
    {
        return status switch
        {
            0 => "Chờ xử lý",
            1 => "Đang xử lý",
            2 => "Đang giao",
            3 => "Đã hoàn thành",
            4 => "Đã hủy",
            _ => "Chờ xử lý"
        };
    }

    public string GetStatusBadgeClass(int? status)
    {
        return status switch
        {
            0 => "badge badge-warning",
            1 => "badge badge-info",
            2 => "badge badge-primary",
            3 => "badge badge-success",
            4 => "badge badge-danger",
            _ => "badge badge-warning"
        };
    }
}

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Danh sách đơn hàng</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Admin</a></li>
                    <li class="breadcrumb-item active">Đơn hàng</li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">

    <!-- Default box -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Quản lý Đơn hàng</h3>

            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse" title="Collapse">
                    <i class="fas fa-minus"></i>
                </button>
                <button type="button" class="btn btn-tool" data-card-widget="remove" title="Remove">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped projects">
                <thead>
                    <tr>
                        <th style="width: 8%">
                            Mã ĐH
                        </th>
                        <th style="width: 15%">
                            Khách hàng
                        </th>
                        <th style="width: 12%">
                            Số điện thoại
                        </th>
                        <th style="width: 15%">
                            Ngày đặt
                        </th>
                        <th style="width: 15%">
                            Tổng tiền
                        </th>
                        <th style="width: 15%">
                            Trạng thái
                        </th>
                        <th style="width: 20%">
                            Thao tác
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        decimal orderTotal = 0;
                        if (item.Details != null)
                        {
                            foreach (var detail in item.Details)
                            {
                                orderTotal += detail.Price * detail.Quantity;
                            }
                        }
                        <tr>
                            <td>
                                #@item.Id
                            </td>
                            <td>
                                @item.CustomerName
                            </td>
                            <td>
                                @item.CustomerPhone
                            </td>
                            <td>
                                @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @orderTotal.ToString("N0") đ
                            </td>
                            <td>
                                <span class="@GetStatusBadgeClass(item.Status)">
                                    @GetStatusText(item.Status)
                                </span>
                            </td>
                            <td>
                                <a class="btn btn-primary btn-sm" asp-action="Details" asp-controller="Order" asp-area="Admin" asp-route-id="@item.Id">
                                    <i class="fas fa-folder">
                                    </i>
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- /.card-body -->
    </div>
    <!-- /.card -->

</section>
<!-- /.content -->
